Name: HPDF
Version: 1.9
cabal-version: >=1.10
License: BSD3
License-file:LICENSE
Copyright: Copyright (c) 2007-2016 alpheccar.org,
                     (c) 2016-2025 HPDF contributors
category: Graphics
synopsis: Generation of PDF documents
maintainer: sylvain@haskus.fr
build-type: Simple
homepage: https://github.com/hsyl20/HPDF
description:
  A PDF library with support for several pages, page transitions,
  outlines, annotations, compression, colors, shapes, patterns, jpegs, fonts,
  typesetting...
  .
  Have a look at the "Graphics.PDF.Documentation" module to see
  how to use it. Or, download the package and look at the test.hs file in the Test
  folder. That file is giving an example of each feature.
extra-source-files:
  Test/logo.jpg
  Test/Penrose.hs
  Test/test.hs
  Test/unicode.hs
  Test/pdfa.hs
  Test/sign.hs
  Test/rewrite.hs
  README.md
  changelog.md
  Core14_AFMs/Courier-Bold.afm
  Core14_AFMs/Helvetica-BoldOblique.afm
  Core14_AFMs/Times-Bold.afm
  Core14_AFMs/Courier-BoldOblique.afm
  Core14_AFMs/Helvetica-Oblique.afm
  Core14_AFMs/Times-BoldItalic.afm
  Core14_AFMs/Courier-Oblique.afm
  Core14_AFMs/Helvetica.afm
  Core14_AFMs/Times-Italic.afm
  Core14_AFMs/Courier.afm
  Core14_AFMs/MustRead.html
  Core14_AFMs/Times-Roman.afm
  Core14_AFMs/Helvetica-Bold.afm
  Core14_AFMs/Symbol.afm
  Core14_AFMs/ZapfDingbats.afm
  Encodings/glyphlist.txt
  Encodings/zapfdingbats.txt
  Encodings/pdfencodings.txt
  Test/logo.jpg

source-repository head
  type:     git
  location: https://github.com/hsyl20/HPDF.git

Test-Suite HPDF-Tests
  Type:              exitcode-stdio-1.0
  Main-is:           HPDF-tests.hs
  hs-source-dirs:    Test
  Other-modules:     Tests.Colours
                     Tests.Common
                     Tests.Document
                     Tests.EmbeddedFiles
                     Tests.Fonts
                     Tests.Image
                     Tests.Numbers
                     Tests.PDFA
                     Tests.PdfFile
                     Tests.Signature
                     Tests.TrueType
                     Tests.Typesetting
  -- A test uses partial patterns (`let Right x = ...`): a failure of the
  -- pattern is a failure of the test.
  ghc-options:       -Wall -Wno-incomplete-uni-patterns -Wno-name-shadowing -Wno-type-defaults
  Build-depends:     base >= 4,
                     tasty >= 1.4,
                     tasty-hunit >= 0.10,
                     HPDF,
                     bytestring,
                     containers,
                     directory,
                     text,
                     zlib
  Default-language:  Haskell2010
  
Executable HPDF-Demo
  Main-is:           test.hs
  hs-source-dirs:    Test
  Build-depends:     base >= 4, 
                     HPDF,
                     random >= 1.0, 
                     text >= 1.2.0,
                     network-uri >= 2.6.0.3,
                     vector >=0.10,
                     array,
                     filepath >= 1.4.0

  Default-language:  Haskell2010
  Other-Modules:
    Penrose

Executable HPDF-Unicode-Demo
  Main-is:           unicode.hs
  hs-source-dirs:    Test
  Build-depends:     base >= 4,
                     HPDF,
                     text >= 1.2.0,
                     directory
  Default-language:  Haskell2010

Executable HPDF-Rewrite-Demo
  Main-is:           rewrite.hs
  hs-source-dirs:    Test
  Build-depends:     base >= 4,
                     HPDF,
                     containers
  Default-language:  Haskell2010

Executable HPDF-Sign-Demo
  Main-is:           sign.hs
  hs-source-dirs:    Test
  Build-depends:     base >= 4,
                     HPDF,
                     bytestring
  Default-language:  Haskell2010

Executable HPDF-PDFA-Demo
  Main-is:           pdfa.hs
  hs-source-dirs:    Test
  Build-depends:     base >= 4,
                     HPDF,
                     bytestring,
                     text >= 1.2.0,
                     directory
  Default-language:  Haskell2010

library
  build-depends: 
      base >= 4.8 && < 5,
      containers,
      random >= 1.0, 
      bytestring >= 0.11, 
      array >= 0.1, 
      zlib >= 0.6, 
      binary >= 0.4, 
      mtl,
      vector >=0.10,
      errors,
      base64-bytestring >= 0.1,
      text >= 1.2.0,
      network-uri >= 2.6.0.3,
      parsec >=3.1.9,
      filepath >= 1.4.0,
      file-embed,
      directory,
      hyphenation,
      crypton >= 2.2,
      crypton-x509 >= 1.9,
      crypton-x509-store >= 1.9,
      ram
  Default-language:  Haskell2010

  ghc-options: -Wall -funbox-strict-fields -O

  exposed-Modules: 
     Graphics.PDF
     Graphics.PDF.Colors
     Graphics.PDF.Coordinates
     Graphics.PDF.Document
     Graphics.PDF.Shapes
     Graphics.PDF.Text
     Graphics.PDF.Fonts.Font
     Graphics.PDF.Fonts.FontTypes
     Graphics.PDF.Fonts.StandardFont
     Graphics.PDF.Fonts.Type1
     Graphics.PDF.Fonts.TrueType
     Graphics.PDF.Typesetting.WritingSystem
     Graphics.PDF.Navigation
     Graphics.PDF.Image
     Graphics.PDF.Action
     Graphics.PDF.Annotation
     Graphics.PDF.Pattern
     Graphics.PDF.Shading
     Graphics.PDF.Transparency
     Graphics.PDF.Expression
     Graphics.PDF.Typesetting
     Graphics.PDF.Documentation
     Graphics.PDF.Archive
     Graphics.PDF.Signature
     Graphics.PDF.File
  Other-Modules:
     Graphics.PDF.LowLevel.Types
     Graphics.PDF.LowLevel.Hash
     Graphics.PDF.LowLevel.Inflate
     Graphics.PDF.File.Object
     Graphics.PDF.File.Lexer
     Graphics.PDF.File.Filter
     Graphics.PDF.File.Write
     Graphics.PDF.File.Parse
     Graphics.PDF.File.ObjectStream
     Graphics.PDF.LowLevel.PNG
     Graphics.PDF.LowLevel.Signature
     Graphics.PDF.LowLevel.CMS
     Graphics.PDF.Data.PDFTree
     Graphics.PDF.Data.Trie
     Graphics.PDF.Pages
     Graphics.PDF.Resources
     Graphics.PDF.Draw
     Graphics.PDF.Typesetting.Breaking
     Graphics.PDF.Typesetting.Horizontal
     Graphics.PDF.Typesetting.Vertical
     Graphics.PDF.Typesetting.Box
     Graphics.PDF.Typesetting.Layout
     Graphics.PDF.LowLevel.Serializer
     Graphics.PDF.Typesetting.StandardStyle
     Graphics.PDF.Fonts.AFMParser
     Graphics.PDF.Fonts.Encoding
